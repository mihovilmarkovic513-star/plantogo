rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && 
             request.auth.token.role == 'SUPER_ADMIN';
    }
    
    function isCompanyAdmin(companyId) {
      return isAuthenticated() && 
             request.auth.token.role == 'COMPANY_ADMIN' &&
             request.auth.token.companyId == companyId;
    }
    
    function isSupervisor(companyId) {
      return isAuthenticated() && 
             request.auth.token.role == 'SUPERVISOR' &&
             request.auth.token.companyId == companyId;
    }
    
    function canManageCompany(companyId) {
      return isSuperAdmin() || isCompanyAdmin(companyId) || isSupervisor(companyId);
    }
    
    function isValidImageUpload() {
      return request.resource.size < 10 * 1024 * 1024 && // 10MB limit
             request.resource.contentType.matches('image/.*');
    }
    
    // Default deny all
    match /{allPaths=**} {
      allow read, write: if false;
    }
    
    // Company assets (logos, etc.)
    match /companies/{companyId}/assets/{fileName} {
      allow read: if isAuthenticated() && 
                     (isSuperAdmin() || 
                      isCompanyAdmin(companyId) || 
                      isSupervisor(companyId) ||
                      request.auth.token.companyId == companyId);
      allow write: if canManageCompany(companyId) && isValidImageUpload();
    }
    
    // Delivery photos - STRICT driver access control
    match /companies/{companyId}/deliveries/{deliveryId}/photos/{photoId} {
      allow read: if isAuthenticated() && 
                     (isSuperAdmin() || 
                      isCompanyAdmin(companyId) || 
                      isSupervisor(companyId) ||
                      (request.auth.token.companyId == companyId && 
                       request.auth.token.role == 'DRIVER' &&
                       firestore.get(/databases/(default)/documents/deliveries/$(deliveryId)).data.driverId == request.auth.uid));
      allow create: if isAuthenticated() && 
                       (canManageCompany(companyId) ||
                        (request.auth.token.companyId == companyId && 
                         request.auth.token.role == 'DRIVER' &&
                         firestore.get(/databases/(default)/documents/deliveries/$(deliveryId)).data.driverId == request.auth.uid)) &&
                       isValidImageUpload();
      allow update: if false; // Photos are immutable
      allow delete: if canManageCompany(companyId);
    }
    
    // Delivery signatures - STRICT driver access control
    match /companies/{companyId}/deliveries/{deliveryId}/signatures/{signatureId} {
      allow read: if isAuthenticated() && 
                     (isSuperAdmin() || 
                      isCompanyAdmin(companyId) || 
                      isSupervisor(companyId) ||
                      (request.auth.token.companyId == companyId && 
                       request.auth.token.role == 'DRIVER' &&
                       firestore.get(/databases/(default)/documents/deliveries/$(deliveryId)).data.driverId == request.auth.uid));
      allow create: if isAuthenticated() && 
                       (canManageCompany(companyId) ||
                        (request.auth.token.companyId == companyId && 
                         request.auth.token.role == 'DRIVER' &&
                         firestore.get(/databases/(default)/documents/deliveries/$(deliveryId)).data.driverId == request.auth.uid)) &&
                       request.resource.size < 5 * 1024 * 1024 && // 5MB limit for signatures
                       request.resource.contentType.matches('image/.*');
      allow update, delete: if false; // Signatures are immutable
    }
  }
}
