rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.role == 'SUPER_ADMIN';
    }
    
    function isCompanyAdmin(companyId) {
      return isAuthenticated() && 
             request.auth.token.role == 'COMPANY_ADMIN' &&
             request.auth.token.companyId == companyId;
    }
    
    function isSupervisor(companyId) {
      return isAuthenticated() && 
             request.auth.token.role == 'SUPERVISOR' &&
             request.auth.token.companyId == companyId;
    }
    
    function isDriver() {
      return isAuthenticated() && request.auth.token.role == 'DRIVER';
    }
    
    function belongsToCompany(companyId) {
      return isAuthenticated() && request.auth.token.companyId == companyId;
    }
    
    function isActive() {
      return isAuthenticated() && request.auth.token.active == true;
    }
    
    function canManageCompany(companyId) {
      return isSuperAdmin() || isCompanyAdmin(companyId);
    }
    
    // Companies Collection
    match /companies/{companyId} {
      // SUPER_ADMIN: full access
      allow read, write: if isSuperAdmin();
      
      // COMPANY_ADMIN, SUPERVISOR: read own company
      allow read: if belongsToCompany(companyId);
      
      // COMPANY_ADMIN: update own company (cannot modify companyId, createdAt, createdBy)
      allow update: if isCompanyAdmin(companyId) && 
                       !request.resource.data.diff(resource.data)
                         .affectedKeys().hasAny(['companyId', 'createdAt', 'createdBy']);
    }
    
    // Users Collection
    match /users/{userId} {
      // SUPER_ADMIN: full access
      allow read, write: if isSuperAdmin();
      
      // COMPANY_ADMIN: read users in own company
      allow read: if isCompanyAdmin(resource.data.companyId);
      
      // SUPERVISOR: read users in own company
      allow read: if isSupervisor(resource.data.companyId);
      
      // DRIVER: read own profile only
      allow read: if request.auth.uid == userId;
      
      // Users can update own profile (cannot modify: userId, companyId, role, createdAt, createdBy, active)
      allow update: if request.auth.uid == userId &&
                       !request.resource.data.diff(resource.data)
                         .affectedKeys().hasAny(['userId', 'companyId', 'role', 'createdAt', 'createdBy', 'active']);
    }
    
    // Usernames Collection (for global uniqueness)
    match /usernames/{username} {
      // Read: authenticated users can check username availability
      allow read: if isAuthenticated();
      
      // Write: server-side only (Cloud Functions)
      allow write: if false;
    }
    
    // Audit Logs Collection
    match /auditLogs/{logId} {
      // SUPER_ADMIN: read all logs
      allow read: if isSuperAdmin();
      
      // COMPANY_ADMIN: read logs for own company
      allow read: if isCompanyAdmin(resource.data.companyId);
      
      // SUPERVISOR: read logs for own company
      allow read: if isSupervisor(resource.data.companyId);
      
      // Write: server-side only (Cloud Functions)
      allow write: if false;
    }
    
    // Legacy collections from Phase 0 (keep for backward compatibility)
    
    // Deliveries Collection
    match /deliveries/{deliveryId} {
      function isAssignedDriver(driverId) {
        return isAuthenticated() && 
               request.auth.token.role == 'DRIVER' &&
               request.auth.uid == driverId;
      }
      
      function canManageOperations(companyId) {
        return isSuperAdmin() || isCompanyAdmin(companyId) || isSupervisor(companyId);
      }
      
      // Read access
      allow read: if isSuperAdmin() || 
                     isCompanyAdmin(resource.data.companyId) || 
                     isSupervisor(resource.data.companyId) || 
                     isAssignedDriver(resource.data.driverId);
      
      // Create/Delete: admins only
      allow create, delete: if canManageOperations(request.resource.data.companyId);
      
      // Update: admins can update all fields, drivers can only update operational fields
      allow update: if canManageOperations(resource.data.companyId) || 
                       (isAssignedDriver(resource.data.driverId) && 
                        !request.resource.data.diff(resource.data)
                          .affectedKeys().hasAny(['companyId', 'driverId', 'customerId', 
                                                  'customerAddress', 'tourId', 'serviceLevelId', 
                                                  'plannedDate', 'applianceIds']));
    }
    
    // Photos Collection
    match /photos/{photoId} {
      function canAccessPhoto() {
        let delivery = get(/databases/$(database)/documents/deliveries/$(resource.data.deliveryId));
        return isSuperAdmin() || 
               isCompanyAdmin(delivery.data.companyId) ||
               isSupervisor(delivery.data.companyId) ||
               (isDriver() && request.auth.uid == delivery.data.driverId);
      }
      
      allow read: if canAccessPhoto();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Photos are immutable
    }
    
    // Signatures Collection
    match /signatures/{signatureId} {
      function canAccessSignature() {
        let delivery = get(/databases/$(database)/documents/deliveries/$(resource.data.deliveryId));
        return isSuperAdmin() || 
               isCompanyAdmin(delivery.data.companyId) ||
               isSupervisor(delivery.data.companyId) ||
               (isDriver() && request.auth.uid == delivery.data.driverId);
      }
      
      allow read: if canAccessSignature();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Signatures are immutable
    }
    
    // Customers Collection
    match /customers/{customerId} {
      allow read: if isSuperAdmin() || belongsToCompany(resource.data.companyId);
      allow write: if isSuperAdmin() || isCompanyAdmin(resource.data.companyId);
    }
    
    // Tours Collection
    match /tours/{tourId} {
      allow read: if isSuperAdmin() || 
                     belongsToCompany(resource.data.companyId) ||
                     (isDriver() && request.auth.uid == resource.data.driverId);
      allow write: if isSuperAdmin() || isCompanyAdmin(resource.data.companyId);
    }
    
    // Stops Collection
    match /stops/{stopId} {
      function canAccessStop() {
        let tour = get(/databases/$(database)/documents/tours/$(resource.data.tourId));
        return isSuperAdmin() || 
               belongsToCompany(tour.data.companyId) ||
               (isDriver() && request.auth.uid == tour.data.driverId);
      }
      
      allow read: if canAccessStop();
      allow write: if isSuperAdmin() || 
                      isCompanyAdmin(get(/databases/$(database)/documents/tours/$(request.resource.data.tourId)).data.companyId);
    }
    
    // Events Collection
    match /events/{eventId} {
      allow read: if isSuperAdmin() || belongsToCompany(resource.data.companyId);
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }
    
    // Notifications Collection
    match /notifications/{notificationId} {
      allow read: if request.auth.uid == resource.data.userId;
      allow create: if false; // Server-side only
      allow update: if request.auth.uid == resource.data.userId; // Mark as read
      allow delete: if request.auth.uid == resource.data.userId;
    }
    
    // Customers collection - company-scoped access
    match /customers/{customerId} {
      allow read: if request.auth != null && 
                     request.auth.token.companyId == resource.data.companyId;
      allow write: if false; // Only Cloud Functions can write
    }
    
    // Delivery Orders collection - company-scoped access
    match /deliveryOrders/{orderId} {
      allow read: if request.auth != null && 
                     request.auth.token.companyId == resource.data.companyId;
      allow write: if false; // Only Cloud Functions can write
      
      // Delivery items subcollection
      match /items/{itemId} {
        allow read: if request.auth != null && 
                       request.auth.token.companyId == resource.data.companyId;
        allow write: if false; // Only Cloud Functions can write
      }
    }
  }
}
